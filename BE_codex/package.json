{
  "name": "scamshield-backend",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint src test",
    "test": "jest --runInBand",
    "build": "nest build",
    "test:e2e": "jest --runInBand --testMatch \"<rootDir>/test/**/*.e2e-spec.ts\""
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/mock-environment.ts"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "ajv": "^8.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "multer": "^2.5.0",
    "openai": "^7.54.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.2"
  }
}
